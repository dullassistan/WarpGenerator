<Window x:Class="WarpGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WARP Генератор" 
        Icon="icon.ico"
        Height="610" Width="930"
        MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowGradient}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER WITH EMBEDDED ALERT -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" CornerRadius="7" Padding="10,6" Margin="0,0,0,8" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <Grid>
                <!-- Logo & Title on Left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="icon.ico" Width="28" Height="28" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WARP Генератор" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="AmneziaWG • WireSock • Clash" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center area: Credits & Alert Message -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                    <!-- Faint grey credits by default -->
                    <TextBlock x:Name="TxtCredits" 
                               Text="Thanks @llimonix, @WARP 1_1_1._1" 
                               FontSize="10" 
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"/>

                    <!-- Alert Message (Shows over credits on events) -->
                    <Border x:Name="AlertBox" 
                            CornerRadius="6" Padding="10,4" 
                            HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtAlert" FontSize="11" FontWeight="Bold" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT: 2-COLUMN SPLIT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: ALL COMPACT SETTINGS IN ONE CARD -->
            <Border x:Name="PnlLeftCard" Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="7" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="7">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 2.1 DNS CHIPS (3x2 GRID) -->
                        <Border Background="{StaticResource CardInnerBg}" CornerRadius="5" Padding="6,5" Margin="0,0,0,5" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DNS Серверы:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextPrimary}" Margin="2,0,0,4"/>
                                <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                                    <RadioButton x:Name="RbDnsCf" Content="1.1.1.1" Tag="cf" GroupName="DnsGroup" Style="{StaticResource FilterChip}" IsChecked="True" Checked="Dns_Checked" ToolTip="Cloudflare DNS (1.1.1.1, 1.0.0.1)"/>
                                    <RadioButton x:Name="RbDnsGoogle" Content="8.8.8.8" Tag="google" GroupName="DnsGroup" Style="{StaticResource FilterChip}" Checked="Dns_Checked" ToolTip="Google DNS (8.8.8.8, 8.8.4.4)"/>
                                    <RadioButton x:Name="RbDnsMalw" Content="dns.malw.link" Tag="malw" GroupName="DnsGroup" Style="{StaticResource FilterChip}" Checked="Dns_Checked" ToolTip="Malw Link DNS (95.216.204.218, 80.253.249.40)"/>
                                    <RadioButton x:Name="RbDnsXbox" Content="xbox-dns.ru" Tag="xbox" GroupName="DnsGroup" Style="{StaticResource FilterChip}" Checked="Dns_Checked" ToolTip="Xbox DNS (111.88.96.50, 111.88.96.51)"/>
                                    <RadioButton x:Name="RbDnsGeohide" Content="geohide.ru" Tag="geohide" GroupName="DnsGroup" Style="{StaticResource FilterChip}" Checked="Dns_Checked" ToolTip="Geohide DNS (45.155.204.190, 37.230.192.51)"/>
                                    <RadioButton x:Name="RbDnsComss" Content="dns.comss.one" Tag="comss" GroupName="DnsGroup" Style="{StaticResource FilterChip}" Checked="Dns_Checked" ToolTip="COMSS.one DNS (83.220.169.155, 212.109.195.93)"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>



                        <!-- 2.3 ENDPOINT & RANDOM -->
                        <Border Background="{StaticResource CardInnerBg}" CornerRadius="5" Padding="6,5" Margin="0,0,0,5" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Endpoint:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="2,0,5,0"/>
                                <TextBox x:Name="TxtEndpoint" Grid.Column="1" Text="188.114.97.66:4500" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed" GotFocus="TxtEndpoint_GotFocus" PreviewMouseLeftButtonDown="TxtEndpoint_PreviewMouseLeftButtonDown" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                                <Button x:Name="BtnEurope" Grid.Column="2" Style="{StaticResource ConvexBtnEmerald}" Height="25" Padding="8,0" Margin="0,0,5,0" FontWeight="SemiBold" FontSize="10.5" ToolTip="Европейские эндпоинты (обход ТСПУ) активны. Кликните для переключения режима." Click="BtnEurope_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="icon_green.ico" Width="14" Height="14" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                        <TextBlock Text="Европа" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRandomEndpoint" Grid.Column="3" Content="🎲 Случайно" Style="{StaticResource ConvexBtnIndigo}" Width="86" Height="25" Margin="0" FontWeight="SemiBold" FontSize="10.5" ToolTip="Сгенерировать случайный рабочий эндпоинт" Click="BtnRandomEndpoint_Click"/>
                            </Grid>
                        </Border>

                        <!-- 2.3 ВЫБОР КЛИЕНТА (С ОФИЦИАЛЬНЫМИ ЗНАЧКАМИ) -->
                        <Border Background="{StaticResource CardInnerBg}" CornerRadius="5" Padding="7,6" Margin="0,0,0,5" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="RbClientAwg" Grid.Column="0" Style="{StaticResource ClientCard}" IsChecked="True" Checked="Client_Changed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="Assets/awg.png" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="AmneziaWG" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbClientWiresock" Grid.Column="1" Style="{StaticResource ClientCard}" Checked="Client_Changed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="Assets/wiresock.png" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="WireSock" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbClientClash" Grid.Column="2" Style="{StaticResource ClientCard}" Checked="Client_Changed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="Assets/clash.png" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Clash" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </Border>

                        <!-- 2.4 ОБФУСКАЦИЯ И ПАРАМЕТРЫ -->
                        <Border x:Name="PnlProtocolSettings" Background="{StaticResource CardInnerBg}" CornerRadius="5" Padding="7,6" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <StackPanel>
                                <!-- === AWG 1.0 === -->
                                <Border BorderBrush="#EDE9FE" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,5">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="SwAwg1" 
                                                          Content="AWG 1.0" 
                                                          FontWeight="Bold" FontSize="10.5" Foreground="#4F46E5"
                                                          Style="{StaticResource ToggleSwitchStyle}" 
                                                          Tag="{StaticResource AccentIndigo}"
                                                          Click="SwAwg1_Click"/>

                                                <StackPanel x:Name="PnlAwg1Custom" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.8" IsEnabled="False">
                                                    <TextBox x:Name="TxtJc" Tag="jc" Text="" Width="32" HorizontalContentAlignment="Center" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed" Margin="0,0,3,0"/>
                                                    <TextBox x:Name="TxtJmin" Tag="jmin" Text="" Width="38" HorizontalContentAlignment="Center" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed" Margin="0,0,3,0"/>
                                                    <TextBox x:Name="TxtJmax" Tag="jmax" Text="" Width="44" HorizontalContentAlignment="Center" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnMasque" Content="Masque" 
                                                        Style="{StaticResource ConvexBtnAmber}" 
                                                        Width="86" Height="25" Margin="0,0,4,0" Opacity="0.55"
                                                        ToolTip="Включить / отключить протокол MASQUE (HTTP/3) для Clash"
                                                        Click="BtnMasque_Click"/>
                                                <Button x:Name="BtnAwgMasque" Content="Awg+Masque" 
                                                        Style="{StaticResource ConvexBtnRose}" 
                                                        Width="86" Height="25" Margin="0" Opacity="0.55"
                                                        ToolTip="Включить / отключить гибридный режим AWG 2.0 + MASQUE Fallback для Clash"
                                                        Click="BtnAwgMasque_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <DockPanel x:Name="PnlAwg1Options" Visibility="Collapsed" Margin="2,4,0,0">
                                            <Button x:Name="BtnAwg1Random" DockPanel.Dock="Right" Content="🎲 Случайно" 
                                                    Style="{StaticResource ConvexBtnIndigo}" 
                                                    Width="86" Height="23"
                                                    HorizontalAlignment="Right" Margin="0"
                                                    Click="BtnAwg1Random_Click"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton x:Name="RbJunk1" Content="4/40/70" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,10,0" IsChecked="True" Checked="ConfigSetting_Changed"/>
                                                <RadioButton x:Name="RbJunk2" Content="30/10/30" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,10,0" Checked="ConfigSetting_Changed"/>
                                                <RadioButton x:Name="RbJunk3" Content="Свой" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,4,0" Checked="ConfigSetting_Changed"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- === AWG 2.0 === -->
                                <Border BorderBrush="#EDE9FE" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,5">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="SwAwg2" 
                                                          Content="AWG 2.0 (QUIC)" 
                                                          FontWeight="Bold" FontSize="10.5" Foreground="#059669"
                                                          Style="{StaticResource ToggleSwitchStyle}" 
                                                          Tag="{StaticResource AccentEmerald}"
                                                          IsChecked="True"
                                                          Click="SwAwg2_Click"/>
                                                <CheckBox x:Name="SwAwg2Custom" 
                                                          Style="{StaticResource ToggleSwitchStyle}" 
                                                          Tag="{StaticResource AccentEmerald}"
                                                          Margin="6,0,0,0"
                                                          ToolTip="Показать поля I2–I5"
                                                          Click="SwAwg2Custom_Click"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnAwg2Domain" Content="🌐 Из домена" 
                                                        Style="{StaticResource ConvexBtnBlue}" 
                                                        Width="86" Height="25" Margin="0,0,4,0"
                                                        Click="BtnAwg2Domain_Click"/>
                                                <Button x:Name="BtnAwg2Random" Content="🎲 Случайно" 
                                                        Style="{StaticResource ConvexBtnEmerald}" 
                                                        Width="86" Height="25" Margin="0"
                                                        Click="BtnAwg2Random_Click"/>
                                            </StackPanel>
                                        </Grid>



                                        <!-- AWG 2.0 Fields for AmneziaWG / Clash -->
                                        <StackPanel x:Name="PnlAwg2Fields" Visibility="Visible" Margin="0,4,0,0">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Left" Text="I1=" Width="24" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TxtI1" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                            </DockPanel>
                                            <Grid x:Name="PnlAwg2ExtraFields" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Grid.Column="0">
                                                    <TextBlock DockPanel.Dock="Left" Text="I2=" Width="24" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox x:Name="TxtI2" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                                </DockPanel>
                                                <DockPanel Grid.Column="2">
                                                    <TextBlock DockPanel.Dock="Left" Text="I3=" Width="24" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox x:Name="TxtI3" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                                </DockPanel>
                                                <DockPanel Grid.Column="4">
                                                    <TextBlock DockPanel.Dock="Left" Text="I4=" Width="24" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox x:Name="TxtI4" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                                </DockPanel>
                                                <DockPanel Grid.Column="6">
                                                    <TextBlock DockPanel.Dock="Left" Text="I5=" Width="24" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox x:Name="TxtI5" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                                </DockPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- WireSock Fields -->
                                        <StackPanel x:Name="PnlWireSockFields" Visibility="Collapsed" Margin="2,4,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="58"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Id:" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBox x:Name="TxtWireSockId" Grid.Column="1" Text="apteka.ru" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed" Margin="0,0,4,0"/>

                                                <TextBlock Grid.Column="2" Text="Ip:" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <ComboBox x:Name="CmbWireSockIp" Grid.Column="3" Height="23" FontSize="10" VerticalContentAlignment="Center" SelectionChanged="ConfigSetting_Changed" Margin="0,0,4,0">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem">
                                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            <Setter Property="MinHeight" Value="20"/>
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                    <ComboBoxItem Content="quic" IsSelected="True"/>
                                                    <ComboBoxItem Content="dns"/>
                                                </ComboBox>

                                                <TextBlock Grid.Column="4" Text="Ib:" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <ComboBox x:Name="CmbWireSockIb" Grid.Column="5" Height="23" FontSize="10" VerticalContentAlignment="Center" SelectionChanged="ConfigSetting_Changed">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem">
                                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            <Setter Property="MinHeight" Value="20"/>
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                    <ComboBoxItem Content="curl" IsSelected="True"/>
                                                    <ComboBoxItem Content="chrome"/>
                                                    <ComboBoxItem Content="firefox"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- === AWG 3.0 === -->
                                <Border BorderBrush="#EDE9FE" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,5">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="SwAwg3" 
                                                      Content="AWG 3.0 (Диапазоны таймаутов)" 
                                                      FontWeight="Bold" FontSize="10.5" Foreground="#7C3AED"
                                                      Style="{StaticResource ToggleSwitchStyle}" 
                                                      Tag="{StaticResource AccentViolet}"
                                                      Click="SwAwg3_Click"/>

                                            <Button x:Name="BtnAwg3Random" Grid.Column="1" Content="🎲 Случайно" 
                                                    Style="{StaticResource ConvexBtnViolet}" 
                                                    Width="86" Height="25"
                                                    HorizontalAlignment="Right" Margin="0"
                                                    Click="BtnAwg3Random_Click"/>
                                        </Grid>

                                        <Grid x:Name="PnlAwg3Options" Visibility="Collapsed" Margin="2,4,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,2,2">
                                                <TextBlock Text="CPA:" FontSize="9.5" FontWeight="SemiBold" Width="28" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtCpa" Width="55" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,2,2">
                                                <TextBlock Text="MHA:" FontSize="9.5" FontWeight="SemiBold" Width="30" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtMha" Width="55" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="KT:" FontSize="9.5" FontWeight="SemiBold" Width="22" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtKt" Width="55" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,2,0">
                                                <TextBlock Text="RAT:" FontSize="9.5" FontWeight="SemiBold" Width="28" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtRat" Width="55" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,2,0">
                                                <TextBlock Text="RKAT:" FontSize="9.5" FontWeight="SemiBold" Width="30" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtRkat" Width="55" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="RT:" FontSize="9.5" FontWeight="SemiBold" Width="22" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtRt" Width="55" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- === AWG 3.1 === -->
                                <Border BorderBrush="#EDE9FE" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,5">
                                    <StackPanel>
                                        <CheckBox x:Name="SwAwg31" 
                                                  Content="AWG 3.1 (Random trailers / Disable cookies)" 
                                                  FontWeight="Bold" FontSize="10.5" Foreground="#D97706"
                                                  Style="{StaticResource ToggleSwitchStyle}" 
                                                  Tag="{StaticResource AccentAmber}"
                                                  Click="SwAwg31_Click"/>

                                        <StackPanel x:Name="PnlAwg31Options" Visibility="Collapsed" Orientation="Horizontal" Margin="0,4,0,0">
                                            <CheckBox x:Name="SwRandomTrailers" 
                                                      Content="Random trailers" 
                                                      FontWeight="SemiBold"
                                                      FontSize="10" 
                                                      Style="{StaticResource ToggleSwitchStyle}" 
                                                      Tag="#6366F1"
                                                      Width="142"
                                                      HorizontalAlignment="Left"
                                                      Click="ConfigSetting_Changed"/>
                                            
                                            <CheckBox x:Name="SwDisableCookies" 
                                                      Content="Disable cookies" 
                                                      FontWeight="SemiBold"
                                                      FontSize="10" 
                                                      Style="{StaticResource ToggleSwitchStyle}" 
                                                      Tag="#EA580C"
                                                      IsChecked="True"
                                                      Click="ConfigSetting_Changed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- === EXCLUDE LAN, KEEPALIVE, IPV6 & MTU === -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <!-- Exclude LAN -->
                                    <CheckBox x:Name="SwExcludeLan" 
                                              Content="Исключить LAN" 
                                              FontWeight="Bold" FontSize="10.5" Foreground="#0891B2"
                                              Style="{StaticResource ToggleSwitchStyle}" 
                                              Tag="{StaticResource AccentCyan}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Click="ConfigSetting_Changed"/>

                                    <!-- Persistent Keepalive -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <CheckBox x:Name="SwKeepalive" 
                                                  Content="Keepalive:" 
                                                  FontWeight="Bold" FontSize="10.5" Foreground="#E11D48"
                                                  Style="{StaticResource ToggleSwitchStyle}" 
                                                  Tag="{StaticResource AccentRose}"
                                                  VerticalAlignment="Center"
                                                  Click="SwKeepalive_Click"/>
                                        <TextBox x:Name="TxtKeepalive" Text="25" Width="28" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- IPv6 -->
                                    <CheckBox x:Name="SwIpv6" 
                                              Content="IPv6" 
                                              FontWeight="Bold" FontSize="10.5" Foreground="#8B5CF6"
                                              Style="{StaticResource ToggleSwitchStyle}" 
                                              Tag="#8B5CF6"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Click="ConfigSetting_Changed"/>

                                    <!-- MTU -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="MTU:" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBox x:Name="TxtMtu" Text="1420" Width="38" Style="{StaticResource ModernTextBox}" TextChanged="ConfigSetting_Changed" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2.5 СКАНЕР ЭНДПОИНТОВ WARP -->
                        <Border Background="{StaticResource CardInnerBg}" CornerRadius="7"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                Padding="10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="⚡ Сканер рабочих эндпоинтов"
                                           FontWeight="Bold" FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#6B7280" Margin="0,3,0,7"
                                           Text="Использует сторонний инструмент warpscout © vernette (лицензия MIT). При первом запуске он будет загружен (~5 МБ) с GitHub и проверен по SHA-256. Проверка поднимает реальные туннели с этой машины и выводит 3 лучших эндпоинта."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnScan" Content="⚡ Сканировать"
                                            Style="{StaticResource ConvexBtnIndigo}"
                                            Click="BtnScan_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnStop" Content="🛑 Стоп"
                                            Style="{StaticResource ConvexBtnRose}"
                                            Click="BtnStop_Click" IsEnabled="False" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnForeignOnly" Content="Только зарубежные"
                                            Style="{StaticResource ConvexBtnAmber}"
                                            Click="BtnForeignOnly_Click" Opacity="0.55"/>
                                </StackPanel>

                                <Border x:Name="PnlScanResults" Visibility="Collapsed"
                                        Background="{StaticResource CardBackground}" CornerRadius="6"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        Padding="8" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="⚡ Топ-3 лучших эндпоинта (кликните для выбора):"
                                                       FontWeight="Bold" FontSize="10.5"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="BtnCloseScanResults" Content="✕"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Width="20" Height="20" Padding="0"
                                                    FontWeight="Bold" Foreground="#64748B"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Click="BtnCloseScanResults_Click"/>
                                        </Grid>
                                        <ItemsControl x:Name="LstScanResults">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="EndpointRow_Click" Cursor="Hand"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="{StaticResource CardInnerBg}"
                                                            BorderBrush="{StaticResource CardBorder}"
                                                            BorderThickness="1" Padding="8,6" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Endpoint}"
                                                                           FontWeight="Bold" FontSize="12"
                                                                           Foreground="#4338CA"/>
                                                                <TextBlock Text="{Binding Location}"
                                                                           FontSize="10" Foreground="#6B7280"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#DCFCE7"
                                                                    CornerRadius="4" Padding="6,2"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PingMs, StringFormat='{}{0} ms'}"
                                                                           FontWeight="Bold" FontSize="10.5"
                                                                           Foreground="#166534"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT COLUMN: CONFIG PREVIEW & 2 GLOSSY ACTION BUTTONS -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" CornerRadius="7" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top title & copy button -->
                        <RowDefinition Height="Auto"/>
                        <!-- Text Box preview -->
                        <RowDefinition Height="*"/>
                        <!-- 2 Action buttons at bottom -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Config header -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Конфигурация" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="📋 Скопировать" Style="{StaticResource ConvexBtnEmerald}" Height="25" Padding="10,0" Click="BtnCopy_Click"/>
                    </Grid>

                    <!-- Code / Config Box -->
                    <TextBox x:Name="TxtConfig" 
                             Grid.Row="1"
                             Background="#0F172A" 
                             Foreground="#38BDF8" 
                             FontFamily="Cascadia Code, Consolas, Segoe UI Mono" 
                             FontSize="11" 
                             Padding="8" 
                             VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Auto" 
                             AcceptsReturn="True" 
                             BorderThickness="0">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- GLOSSY ACTION BUTTONS: 2x2 PROMINENT GRID -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnGenerate" Grid.Row="0" Grid.Column="0" Content="⚡ Сгенерировать" Style="{StaticResource ConvexBtnIndigo}" Height="30" Click="BtnGenerate_Click"/>
                        <Button x:Name="BtnDownloadSingle" Grid.Row="0" Grid.Column="2" Content="💾 Скачать файл" Style="{StaticResource ConvexBtnBlue}" Height="30" Click="BtnDownloadSingle_Click"/>
                        <Button x:Name="BtnDownloadEurope10" Grid.Row="2" Grid.Column="0" Style="{StaticResource ConvexBtnViolet}" Height="30" Click="BtnDownloadEurope10_Click" ToolTip="Сгенерировать и скачать архив из 10 конфигураций с европейскими эндпоинтами">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="icon_green.ico" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                <TextBlock Text="Случайные Европа (10)" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDownloadAnycast10" Grid.Row="2" Grid.Column="2" Style="{StaticResource ConvexBtnSlate}" Height="30" Click="BtnDownloadAnycast10_Click" ToolTip="Сгенерировать и скачать архив из 10 конфигураций со стандартными (Anycast) эндпоинтами">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="icon.ico" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                <TextBlock Text="Случайные 10" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
